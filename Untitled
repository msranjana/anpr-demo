# Camera stream
RTSP_URL=rtsp://localhost:8554/live/video

# Where the event engine writes its log lines
LOG_FILE_PATH=logs/events.log

# Seconds to wait before reconnecting to the camera after a read failure
RECONNECT_DELAY=5

# ANPR (EasyOCR + Moondream hybrid)
ANPR_FPS=2
EASYOCR_GPU=false
MOONDREAM_ENABLED=true
MOONDREAM_MODEL_PATH=models/moondream/moondream-0_5b-int4.mf.gz
MOONDREAM_REPO_ID=vikhyatk/moondream2
MOONDREAM_MODEL_FILE=moondream-0_5b-int4.mf.gz
MOONDREAM_REPO_REVISION=9dddae84d54db4ac56fe37817aeaeb502ed083e2
ANPR_MIN_PLATE_LENGTH=4
ANPR_MAX_PLATE_LENGTH=12
ANPR_VOTER_WINDOW=5
ANPR_VOTER_MIN_VOTES=3
ANPR_ALERT_COOLDOWN=15

# Alert engine (SMTP) - leave empty until the mail account is ready
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_FROM_EMAIL=
ALERT_TO_EMAILS=
